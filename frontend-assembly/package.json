{
  "name": "frontend-assembly",
  "version": "1.0.0",
  "description": "CodeMirror build for ETPGRF",
  "main": "index.js",
  "scripts": {
    "build:codemirror": "esbuild src/editor.js --bundle --format=esm --outfile=../public/static/codemirror/editor.js --minify",
    "build:vendor": "node copy-vendor.js",
    "build": "npm run build:codemirror && npm run build:vendor",
    "dev": "npm run build",
    "watch": "esbuild src/editor.js --bundle --format=esm --outfile=../public/static/codemirror/editor.js --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/language": "^6.12.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "alpinejs": "^3.14.8",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "codemirror": "^6.0.2",
    "htmx.org": "^1.9.12"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
