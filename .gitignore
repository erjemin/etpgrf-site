# ==============================================================================
# .gitignore для проекта ETPGRF Site (Django + Node.js/Frontend + Docker)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Среды разработки и редакторы кода (IDE & Editors)
# ------------------------------------------------------------------------------
# JetBrains IDEs (PyCharm, WebStorm, IntelliJ IDEA и др.):
# Игнорируем полностью конфигурационную директорию .idea, чтобы локальные настройки,
# списки задач, кэши индексации и конфигурации раннеров не попадали в репозиторий.
.idea/
*.iml
*.iws
*.ipr

# Visual Studio Code:
# Локальные настройки редактора, конфигурации отладки и расширений
.vscode/
*.code-workspace

# Временные файлы текстовых редакторов (Vim, Emacs, Nano):
*~
*.swp
*.swo
*.swn
.#*
\#*#

# ------------------------------------------------------------------------------
# 2. Файлы операционных систем (OS metadata)
# ------------------------------------------------------------------------------
# macOS: файлы кэша структуры папок и метаданных Finder
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows: кэши миниатюр и настройки отображения папок
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux: служебные файлы
*~

# ------------------------------------------------------------------------------
# 3. Python и виртуальные окружения (Python & Virtual Environments)
# ------------------------------------------------------------------------------
# Байткод Python и кэши скомпилированных файлов:
__pycache__/
*.py[cod]
*$py.class
*.so

# Виртуальные окружения (локальные папки с установленными зависимостями):
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Артефакты сборки, дистрибутивы и метаданные пакетов:
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Кэши инструментов статического анализа, тестирования и типизации:
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 4. Django, базы данных, медиа-файлы и секреты (Django, DB & Secrets)
# ------------------------------------------------------------------------------
# Конфигурационные файлы с секретами и локальными переменными окружения:
.env
.env.*
!.env.example

# Базы данных SQLite (локальные тестовые и рабочие БД):
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
db.sqlite3
data/*.sqlite3
data/*.db
data/*.sqlite3-journal
data/*.db-journal
!data/README.md

# Локально загружаемые медиа-файлы (пользовательский контент: картинки блога и т.д.):
media/*
!media/README.md
!media/.gitkeep

# Лог-файлы:
*.log
logs/

# ------------------------------------------------------------------------------
# 5. Node.js, npm и фронтенд-сборка (Frontend Assembly)
# ------------------------------------------------------------------------------
# Зависимости npm (устанавливаются через npm install / assembly_via_npm.sh):
node_modules/
*/node_modules/
frontend-assembly/node_modules/

# Логи пакетных менеджеров:
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Директории сборки и бандлов:
frontend-assembly/dist/

# ------------------------------------------------------------------------------
# 6. Временные файлы и артефакты отладки
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
.output.txt
